{
  "expo": {
    "name": "GojolBook",
    "slug": "gojol-notebook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gojolnotebook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "backgroundColor": "#063c2e",
      "predictiveBackGestureEnabled": false,
      "package": "com.zaheenrakib.gojolnotebook"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#063c2e"
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "75f0bfe1-a6b4-4c6f-8fd1-7fac5d01852d"
      }
    }
  }
}
